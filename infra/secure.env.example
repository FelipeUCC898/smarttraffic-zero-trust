# Perfil seguro: completar fuera de Git con valores del proveedor cloud.
SECURE_PROFILE=secure

# Kafka SASL_SSL / OAuth2
KAFKA_BOOTSTRAP_SERVERS=broker.example.internal:9093
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=OAUTHBEARER
KAFKA_SSL_TRUSTSTORE_LOCATION=/run/secrets/kafka-truststore.p12
KAFKA_SSL_TRUSTSTORE_PASSWORD=REPLACE_OUTSIDE_REPOSITORY

# RabbitMQ TLS + JWT como credencial de servicio
RABBITMQ_HOST=rabbitmq.example.internal
RABBITMQ_PORT=5671
RABBITMQ_VHOST=/smarttraffic
RABBITMQ_SSL_ENABLED=true
RABBITMQ_SSL_TRUSTSTORE=/run/secrets/rabbitmq-ca.pem
RABBITMQ_SSL_VERIFY_HOSTNAME=true

# Auth Server HTTPS
AUTH_TOKEN_ENDPOINT=https://auth.example.internal:8443/token
AUTH_SERVER_PORT=8443
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=/run/secrets/auth-server.p12
SERVER_SSL_KEY_STORE_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_SSL_KEY_ALIAS=auth-server

# Client secrets are injected by the secret manager, never committed.
AUTH_CLIENT_TRAFFIC_SIMULATOR_SECRET=REPLACE_OUTSIDE_REPOSITORY
AUTH_CLIENT_PROCESSOR_SECRET=REPLACE_OUTSIDE_REPOSITORY
