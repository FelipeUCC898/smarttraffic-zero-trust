# Perfil seguro: completar fuera de Git con valores del proveedor cloud.
SECURE_PROFILE=secure

# Kafka SASL_SSL / OAuth2
KAFKA_BOOTSTRAP_SERVERS=broker.example.internal:9093
SECURE_KAFKA_BOOTSTRAP_SERVERS=broker.example.internal:9093
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=OAUTHBEARER
KAFKA_TRUSTSTORE=/run/secrets/kafka-truststore.p12
KAFKA_TRUSTSTORE_TYPE=PKCS12
KAFKA_TRUSTSTORE_PASSWORD=REPLACE_OUTSIDE_REPOSITORY

# RabbitMQ TLS + JWT como credencial de servicio
RABBITMQ_HOST=rabbitmq.example.internal
RABBITMQ_PORT=5671
RABBITMQ_VHOST=/smarttraffic
RABBITMQ_SSL_ENABLED=true
RABBITMQ_TRUSTSTORE=file:/run/secrets/rabbitmq-truststore.p12
RABBITMQ_TRUSTSTORE_TYPE=PKCS12
RABBITMQ_TRUSTSTORE_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
RABBITMQ_SSL_VERIFY_HOSTNAME=true

# Auth Server HTTPS
AUTH_TOKEN_ENDPOINT=https://auth.example.internal:8443/token
SECURE_AUTH_TOKEN_ENDPOINT=https://auth.example.internal:8443/token
AUTH_CA_CERTIFICATE=/run/secrets/ca.pem
AUTH_JWT_ISSUER=smarttraffic-auth
AUTH_JWT_AUDIENCE=smarttraffic-brokers
SECURITY_JWT_PRIVATE_KEY=/run/secrets/auth-jwt-private.pem
SECURITY_JWT_PUBLIC_KEY=/run/secrets/auth-jwt-public.pem
AUTH_SERVER_PORT=8443
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=/run/secrets/auth-server.p12
SERVER_SSL_KEY_STORE_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_SSL_KEY_ALIAS=auth-server

# Client secrets are injected by the secret manager, never committed.
AUTH_CLIENT_TRAFFIC_SIMULATOR_SECRET=REPLACE_OUTSIDE_REPOSITORY
AUTH_CLIENT_PROCESSOR_SECRET=REPLACE_OUTSIDE_REPOSITORY
AUTH_CLIENT_TRAFFIC_ARCHIVER_SECRET=REPLACE_OUTSIDE_REPOSITORY
AUTH_CLIENT_ALERT_DISPATCHER_SECRET=REPLACE_OUTSIDE_REPOSITORY
AUTH_CLIENT_QUERY_CLIENT_SECRET=REPLACE_OUTSIDE_REPOSITORY
AUTH_CLIENT_TRAFFIC_DASHBOARD_SECRET=REPLACE_OUTSIDE_REPOSITORY
