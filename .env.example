POSTGRES_DB=smarttraffic
POSTGRES_USER=smarttraffic
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
KAFKA_PORT=9092
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
DASHBOARD_PORT=8081
KAFKA_ARCHIVER_GROUP=traffic-archiver-v1
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_SECONDS=900
AUTH_CLIENT_TRAFFIC_SIMULATOR_SECRET=REPLACE_WITH_SIMULATOR_SECRET
AUTH_CLIENT_PROCESSOR_SECRET=REPLACE_WITH_PROCESSOR_SECRET
AUTH_CLIENT_TRAFFIC_ARCHIVER_SECRET=REPLACE_WITH_ARCHIVER_SECRET
AUTH_CLIENT_ALERT_DISPATCHER_SECRET=REPLACE_WITH_ALERT_DISPATCHER_SECRET
AUTH_CLIENT_QUERY_CLIENT_SECRET=REPLACE_WITH_QUERY_CLIENT_SECRET
AUTH_JWT_ISSUER=smarttraffic-auth
AUTH_JWT_AUDIENCE=smarttraffic-brokers

# Perfil secure-integration: no activar con el Compose local PLAINTEXT.
SECURE_CERTS_DIR=C:/ruta/local/a/secretos
AUTH_CA_CERTIFICATE=/run/secrets/auth-ca.pem
AUTH_TRUSTSTORE=/run/secrets/auth-truststore.p12
AUTH_TRUSTSTORE_TYPE=PKCS12
AUTH_TRUSTSTORE_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
KAFKA_TRUSTSTORE=/run/secrets/kafka-truststore.p12
KAFKA_TRUSTSTORE_TYPE=PKCS12
KAFKA_TRUSTSTORE_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
RABBITMQ_TRUSTSTORE=/run/secrets/rabbitmq-truststore.p12
RABBITMQ_TRUSTSTORE_TYPE=PKCS12
RABBITMQ_TRUSTSTORE_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
